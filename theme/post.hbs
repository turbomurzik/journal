{{!< default}}

{{#post}}
<main class="article-page">
    <article>
        <header class="article-header">
            {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-dek">{{custom_excerpt}}</p>{{/if}}
            <div class="article-byline">
                <span>By {{#foreach authors}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</span>
                <span>{{date format="D MMMM YYYY"}}</span>
                <span>{{reading_time}}</span>
            </div>
        </header>

        {{#if feature_image}}
            <figure class="article-feature">
                <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}

        <div class="article-content gh-content">{{content}}</div>

        <footer class="article-footer">
            <div class="article-footer__authors">
                {{#foreach authors}}
                    <div class="author-line">
                        {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
                        <div>
                            <strong><a href="{{url}}">{{name}}</a></strong>
                            {{#if bio}}<p>{{bio}}</p>{{/if}}
                        </div>
                    </div>
                {{/foreach}}
            </div>
            {{#if tags}}<div class="article-tags">{{tags separator=" · "}}</div>{{/if}}
        </footer>
    </article>
</main>
{{/post}}
