{{!< default}}

<main class="site-main">
    <section class="front-intro">
        <div class="front-intro__label">The argument matters more than the category.</div>
        {{#if @site.description}}
            <p class="front-intro__copy">{{@site.description}}</p>
        {{else}}
            <p class="front-intro__copy">Essays that reopen familiar ideas and make settled categories difficult to use lazily.</p>
        {{/if}}
    </section>

    {{#foreach posts}}
        {{#if @first}}
            <section class="lead-story">
                {{#if feature_image}}
                    <a class="lead-story__image" href="{{url}}">
                        <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                    </a>
                {{/if}}
                <div class="lead-story__body">
                    {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
                    <h1><a href="{{url}}">{{title}}</a></h1>
                    {{#if custom_excerpt}}<p class="lead-story__dek">{{custom_excerpt}}</p>{{else}}<p class="lead-story__dek">{{excerpt words="42"}}</p>{{/if}}
                    <div class="lead-story__meta">
                        <span>By {{primary_author.name}}</span>
                        <span>{{date format="D MMMM YYYY"}}</span>
                    </div>
                </div>
            </section>
        {{/if}}
    {{/foreach}}

    <div class="section-heading">
        <h2>Latest</h2>
        <span>Essays · Reviews · Arguments</span>
    </div>

    <section class="article-grid">
        {{#foreach posts}}
            {{#unless @first}}{{> "article-card"}}{{/unless}}
        {{/foreach}}
    </section>

    <div class="pagination-wrap">{{pagination}}</div>
</main>
