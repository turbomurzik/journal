<article class="article-card">
    {{#if feature_image}}
        <a class="article-card__image" href="{{url}}" aria-label="{{title}}">
            <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
        </a>
    {{/if}}
    <div class="article-card__body">
        {{#if primary_tag}}<a class="eyebrow" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        <h2 class="article-card__title"><a href="{{url}}">{{title}}</a></h2>
        {{#if custom_excerpt}}<p class="article-card__dek">{{custom_excerpt}}</p>{{else}}<p class="article-card__dek">{{excerpt words="28"}}</p>{{/if}}
        <div class="article-card__meta">
            <span>{{primary_author.name}}</span>
            <span>{{date format="D MMMM YYYY"}}</span>
        </div>
    </div>
</article>
