{{!< default}}

<main class="site-main">
    {{#author}}
    <header class="archive-header author-header">
        {{#if profile_image}}<img class="author-header__image" src="{{img_url profile_image size="s"}}" alt="{{name}}">{{/if}}
        <div>
            <span class="eyebrow">Contributor</span>
            <h1>{{name}}</h1>
            {{#if bio}}<p>{{bio}}</p>{{/if}}
        </div>
    </header>
    {{/author}}
    <section class="article-grid">
        {{#foreach posts}}{{> "article-card"}}{{/foreach}}
    </section>
    <div class="pagination-wrap">{{pagination}}</div>
</main>
